PORT=8080
DATABASE_URL=postgres://nudge:nudge@localhost:5432/nudge?sslmode=disable
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URL=http://localhost:8080/slack/oauth/callback
RAINDROP_CLIENT_ID=
RAINDROP_CLIENT_SECRET=
RAINDROP_REDIRECT_URL=http://localhost:8080/raindrop/oauth/callback
NUDGE_REMINDER_USER_ID=1
NUDGE_PUBLIC_URL=http://localhost:8080
NUDGE_TIMEZONE=Europe/Istanbul
# Independent random administrative credentials; empty values disable access.
# API requests need Authorization: Bearer <NUDGE_API_TOKEN> plus X-User-ID.
NUDGE_API_TOKEN=
# Required dedicated 32-byte base64 key (openssl rand -base64 32).
NUDGE_LINK_SIGNING_KEY=
# Required independent key for stored Feedbin passwords (openssl rand -base64 32).
FEEDBIN_ENCRYPTION_KEY=
# Extra protection for test endpoints, in addition to the API bearer token.
NUDGE_TEST_TOKEN=
# Dashboard is disabled without this independent token; use X-Dashboard-Token.
NUDGE_DASHBOARD_TOKEN=
# Codex app-server is the only assistant harness. No legacy-provider fallback.
# Required: choose a Responses-compatible model together before deployment.
CODEX_MODEL=
# Dedicated server-side API credential; no desktop ChatGPT login is imported.
CODEX_API_KEY=
# Binary is installed at pinned version by Docker. Optional local override.
CODEX_BINARY=codex
# Mount a persistent writable volume here (runtime uid/gid 1000).
NUDGY_CODEX_STATE_DIR=/var/lib/nudgy/codex
# Optional public web-search TOOL used only when Codex requests it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
