PORT=8080
DATABASE_URL=postgres://nudge:nudge@localhost:5432/nudge?sslmode=disable
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URL=http://localhost:8080/slack/oauth/callback
RAINDROP_CLIENT_ID=
RAINDROP_CLIENT_SECRET=
RAINDROP_REDIRECT_URL=http://localhost:8080/raindrop/oauth/callback
NUDGE_REMINDER_USER_ID=1
NUDGE_PUBLIC_URL=http://localhost:8080
NUDGE_TIMEZONE=Europe/Istanbul
NUDGE_TEST_TOKEN=
# Optional token for the private AI analytics API. Keep this set in production.
NUDGE_DASHBOARD_TOKEN=
# OpenRouter core assistant and RSS analysis (takes priority when configured)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# Complex requests are escalated to this paid OpenRouter model.
OPENROUTER_COMPLEX_MODEL=deepseek/deepseek-v4.1-flash
# OpenAI core assistant and RSS analysis
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
# OpenCode-hosted free DeepSeek V4.1 Flash
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/v1
OPENCODE_MODEL=deepseek-v4.1-flash-free
# Direct DeepSeek API fallback (paid, optional)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional: only needed for live Google web search. Core Nudgy uses DeepSeek.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
