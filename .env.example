PORT=8080
DATABASE_URL=postgres://nudge:nudge@localhost:5432/nudge?sslmode=disable
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URL=http://localhost:8080/slack/oauth/callback
RAINDROP_CLIENT_ID=
RAINDROP_CLIENT_SECRET=
RAINDROP_REDIRECT_URL=http://localhost:8080/raindrop/oauth/callback
NUDGE_REMINDER_USER_ID=1
NUDGE_PUBLIC_URL=http://localhost:8080
NUDGE_TIMEZONE=Europe/Istanbul
# Legacy global operator APIs (/api/v1, /api/dashboard) are no longer exposed.
# Dashboard Slack sign-in reuses SLACK_CLIENT_ID/SECRET/REDIRECT_URL above.
# Customer sessions last 12 hours and are scoped to /dashboard.
# Required dedicated 32-byte base64 key (openssl rand -base64 32).
NUDGE_LINK_SIGNING_KEY=
# Required independent key for stored Feedbin passwords (openssl rand -base64 32).
FEEDBIN_ENCRYPTION_KEY=
# Extra protection for test endpoints, in addition to the API bearer token.
NUDGE_TEST_TOKEN=
# Each workspace saves its OWN AI provider key and models in /dashboard/ai.
# No server OPENROUTER_API_KEY, OPENAI_API_KEY, CODEX_*_MODEL or GEMINI_API_KEY fallback.
# Optional dedicated 32-byte base64 encryption key for stored workspace AI keys.
# If unset, FEEDBIN_ENCRYPTION_KEY is used. Choose once before first save and keep stable.
NUDGY_AI_ENCRYPTION_KEY=
# Binary is installed at pinned version by Docker. Optional local override.
CODEX_BINARY=codex
# Mount a persistent writable volume here (runtime uid/gid 1000).
NUDGY_CODEX_STATE_DIR=/var/lib/nudgy/codex
# Optional Google search credentials and model are also configured per workspace
# in the dashboard, never through a shared server-side provider account.
# Optional GitLab.com OAuth integration; separate from the GitHub App settings.
NUDGY_GITLAB_ENABLED=false
NUDGY_GITLAB_CLIENT_ID=
NUDGY_GITLAB_CLIENT_SECRET=
# Reuse the existing NUDGY_CODING_ENCRYPTION_KEY when enabling both providers.
# See docs/gitlab.md for the callback URI and OAuth scopes.
# Optional Jira Cloud and Trello OAuth connections (read, create and move tasks).
# See docs/jira-trello.md for app registration, scopes and callback URLs.
NUDGY_JIRA_ENABLED=false
NUDGY_JIRA_CLIENT_ID=
NUDGY_JIRA_CLIENT_SECRET=
NUDGY_TRELLO_ENABLED=false
NUDGY_TRELLO_CLIENT_ID=
NUDGY_TRELLO_CLIENT_SECRET=
# Dedicated, persistent 32-byte base64 key for Jira/Trello tokens.
NUDGY_TRACKER_ENCRYPTION_KEY=
